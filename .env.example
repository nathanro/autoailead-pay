# Copy to .env.local for local development (never commit .env.local)

# PayPal Sandbox REST app (https://developer.paypal.com/dashboard/)
PAYPAL_SANDBOX_CLIENT_ID=your_sandbox_client_id
PAYPAL_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# Legacy names (optional fallback if you already use these)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# LLM provider (OpenAI-compatible API)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: force demo/mock PayPal even when sandbox creds exist
# DEMO_MODE=true

# Public app URL (PayPal return/cancel URLs and webhook registration)
APP_URL=http://localhost:43123
